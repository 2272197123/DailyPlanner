# Server data
server/dailyplan.db
server/dailyplan.db-shm
server/dailyplan.db-wal
dailyplan.db
dailyplan.db-shm
dailyplan.db-wal
*.db-journal

# Fuse filesystem artifacts
.fuse_hidden*

# Environment
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# AI assistant session artifacts
.claude/
.workbuddy/

# Trellis runtime (session-scoped ephemera)
.trellis/.runtime/
