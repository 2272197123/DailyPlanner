*.egg-info/
*.pyo
*.pyd
.Python
build/
dist/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node / Vite / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.local
.vite/
dist-ssr/
