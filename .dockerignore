# ═══════════════════════════════════════
# Docker ignore — 不打包到镜像
# ═══════════════════════════════════════

# 环境（含 Key，本地独有）
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 数据库文件（容器内用 MySQL，不需要 SQLite）
server/*.db
server/*.db-shm
server/*.db-wal

# 用户上传文件（容器内由 appdata volume 提供）
data/

# 前端依赖与构建产物（源码必须保留：Dockerfile 多阶段构建需要）
**/node_modules/
frontend/dist/

# 部署/运维参考脚本，不进镜像
scripts/

# 开发流程与文档
.trellis/
.claude/
*.md
AGENTS.md
CLAUDE.md

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# 其他
node_modules/
*.log
启动.bat
