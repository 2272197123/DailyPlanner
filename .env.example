# ═══════════════════════════════════════
# DailyPlan 环境变量模板
# 复制为 .env 并填入真实值
#   cp .env.example .env
# ═══════════════════════════════════════

# ── 数据库 ──
# 类型: sqlite | mysql | postgres
DP_DB_TYPE=sqlite
# PostgreSQL（docker compose 自动设置）
# DP_POSTGRES_HOST=localhost
# DP_POSTGRES_PORT=5432
# DP_POSTGRES_USER=dailyplan
# DP_POSTGRES_PASSWORD=dailyplan
# DP_POSTGRES_DB=dailyplan

# ── AI 服务 ──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DP_AI_MODEL=deepseek-chat

# ── 安全 ──
# 生产环境务必改为随机字符串（生成: python -c "import secrets; print(secrets.token_urlsafe(32))"）
DP_SECRET_KEY=change-me-in-production

# ── 部署 ──
# 服务器监听端口
PORT=5000
