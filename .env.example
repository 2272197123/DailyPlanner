# ═══════════════════════════════════════
# DailyPlan 环境变量模板
# 复制为 .env 并填入真实值
#   cp .env.example .env
# ═══════════════════════════════════════

# ── 运行环境 ──
# development | production
# production 模式下启动会做严格校验（密钥、数据库参数缺失即拒绝启动）
DP_ENV=development

# ── 数据库 ──
# 类型: sqlite（开发默认，零依赖） | mysql（生产推荐） | postgres
DP_DB_TYPE=sqlite

# MySQL（DP_DB_TYPE=mysql 时必填；docker compose 会自动注入）
# DP_MYSQL_HOST=localhost
# DP_MYSQL_PORT=3306
# DP_MYSQL_USER=dailyplan
# DP_MYSQL_PASSWORD=改为强密码
# DP_MYSQL_DB=dailyplan
# 或用完整 URL（优先于上面的分项）：
# DP_MYSQL_URL=mysql://dailyplan:password@localhost:3306/dailyplan
# docker compose 部署时还需要 MySQL root 密码（仅用于初始化建库）：
# DP_MYSQL_ROOT_PASSWORD=改为强密码

# PostgreSQL（可选）
# DP_POSTGRES_HOST=localhost
# DP_POSTGRES_PORT=5432
# DP_POSTGRES_USER=dailyplan
# DP_POSTGRES_PASSWORD=改为强密码
# DP_POSTGRES_DB=dailyplan
# DP_POSTGRES_URL=postgresql://dailyplan:password@localhost:5432/dailyplan

# ── 注册模式（白名单） ──
# invite_only：必须持有效邀请码才能注册（推荐，第一个用户自动成为管理员）
# open：任何人可注册
DP_REGISTRATION_MODE=invite_only

# ── 游客模式 ──
# 一键临时账号（无需邀请码），数据隔离，到期自动清理
DP_GUEST_ENABLED=true
DP_GUEST_TTL_DAYS=7

# ── SMTP 邮件（注册验证码，生产必填） ──
# 以 QQ 邮箱为例：SMTP 密码填"授权码"（设置 → 账号 → POP3/SMTP 服务开启后生成）
# 163 邮箱：DP_SMTP_HOST=smtp.163.com；腾讯企业邮：smtp.exmail.qq.com
# DP_SMTP_HOST=smtp.qq.com
# DP_SMTP_PORT=465
# DP_SMTP_USERNAME=your@qq.com
# DP_SMTP_PASSWORD=邮箱授权码
# DP_SMTP_FROM=your@qq.com
# 开发环境未配置 SMTP 时，发送验证码接口会在响应中回传 dev_code 便于测试

# ── AI 服务 ──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DP_AI_MODEL=deepseek-chat

# ── 安全 ──
# 生产环境必须改为随机字符串，且不少于 32 字符
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
DP_SECRET_KEY=change-me-in-production

# ── CORS ──
# 允许的跨域来源，逗号分隔；同源部署（Nginx 反代）时无需配置
DP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 日志 ──
# DEBUG | INFO | WARNING | ERROR
DP_LOG_LEVEL=INFO

# ── 部署 ──
# 服务器监听端口
PORT=5000
